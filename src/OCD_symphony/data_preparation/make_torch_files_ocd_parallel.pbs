#!/bin/bash

##########################################################################
#
#  Script:    make_torch_files_ocd_parallel.pbs
#  Author:    Sebastien Naze
#  Created:   2025-10
#  Updated:   paper-matched preprocessing (default mode of make_torch_files_ocd.py)
#
##########################################################################
#
# One array job per OCD subject. Subjects are read from data/subject_list.txt (one ID per line).
#
# Submit (N = number of lines in data/subject_list.txt, 98 at the time of writing):
#   qsub -J 1-98 make_torch_files_ocd_parallel.pbs
#   qsub -J 1-98 -v OUT_DIR=/path/to/out,OVERWRITE=1 make_torch_files_ocd_parallel.pbs
#
# OUT_DIR    output folder (default: data/OCD_paper). Metadata (settings, N=2, FD threshold,
#            TR, sources) is written next to the subject files.
# OVERWRITE  set to 1 to recompute subjects that already have an output file.
#
# Legacy extraction is not run from this script (use make_torch_files_ocd.py --legacy directly).
#
#PBS -N make_torch_files_ocd_paper
#PBS -l ncpus=2,mem=32gb,walltime=00:45:00
#PBS -m abe
#PBS -M sebastien.naze@qimrberghofer.edu.au
#PBS -o /working/lab_lucac/sebastiN/projects/OCD_Symphony/.pbs_logs/
#PBS -e /working/lab_lucac/sebastiN/projects/OCD_Symphony/.pbs_logs/
#
# Script to extract paper-matched ROI time series from OCD fMRIPrep-FIX data into torch files
#
#module load fsl/6.0.1

#module load miniconda3/current

source activate ocd-symphony

proj_dir=/mnt/lustre/working/lab_lucac/sebastiN/projects/OCD_Symphony/
cd ${proj_dir}

# load specific subject from the subject list
mapfile -t subj_array < <(tr -d '\r' < ${proj_dir}data/subject_list.txt | grep -v '^$')
IDX=$((PBS_ARRAY_INDEX-1))  # double parenthesis needed for arithmetic operations
subj=${subj_array[$IDX]}
if [ -z "${subj}" ]; then
    echo "No subject for array index ${PBS_ARRAY_INDEX} (${#subj_array[@]} subjects listed)"
    exit 1
fi
echo "Current subject: " ${subj}

out_args=""
if [ -n "${OUT_DIR}" ]; then out_args="--out_dir ${OUT_DIR}"; fi
if [ "${OVERWRITE}" == "1" ]; then out_args="${out_args} --overwrite"; fi

echo 'Extracting paper-matched time series, compute FC, and store in torch file ...'
python ${proj_dir}src/OCD_symphony/data_preparation/make_torch_files_ocd.py --subj $subj ${out_args}
