#!/bin/bash

##########################################################################
#
#  Script:    make_torch_files_hcp_parallel.pbs
#  Author:    Sebastien Naze
#  Created:   2025-10
#  Updated:   paper-matched preprocessing (default mode of make_torch_files_hcp.py)
#
##########################################################################
#
# One array job per HCP-YA subject. Index = position in the sorted list of subjects that have
# demographics and an extracted MNINonLinear folder (same list as make_torch_files_hcp.py --idx).
# Each job cleans its 4 resting runs (about 13 minutes per subject), so the walltime is 1 h.
#
# Submit (N = number of subjects in that list; check with the count printed by the first job):
#   qsub -J 1-1000 make_torch_files_hcp_parallel.pbs
#   qsub -J 1-1000 -v OUT_DIR=/path/to/out,OVERWRITE=1 make_torch_files_hcp_parallel.pbs
#
# OUT_DIR    output folder (default: data/hcp_paper).
# OVERWRITE  set to 1 to recompute subjects that already have an output file.
#
# Legacy extraction is not run from this script (use make_torch_files_hcp.py --legacy directly).
#
#PBS -N make_torch_files_hcp_paper
#PBS -l ncpus=2,mem=64gb,walltime=01:00:00
#PBS -m abe
#PBS -M sebastien.naze@qimrberghofer.edu.au
#PBS -o /working/lab_lucac/sebastiN/projects/OCD_Symphony/.pbs_logs/
#PBS -e /working/lab_lucac/sebastiN/projects/OCD_Symphony/.pbs_logs/
#
# Script to extract paper-matched ROI time series from HCP-YA data into torch files
#
#module load fsl/6.0.1

#module load miniconda3/current

source activate ocd-symphony

proj_dir=/mnt/lustre/working/lab_lucac/sebastiN/projects/OCD_Symphony/
cd ${proj_dir}

IDX=$((PBS_ARRAY_INDEX-1))  # double parenthesis needed for arithmetic operations
echo "Array index: ${IDX}"

out_args=""
if [ -n "${OUT_DIR}" ]; then out_args="--out_dir ${OUT_DIR}"; fi
if [ "${OVERWRITE}" == "1" ]; then out_args="${out_args} --overwrite"; fi

echo 'Extracting paper-matched time series, compute FC, and store in torch file ...'
python ${proj_dir}src/OCD_symphony/data_preparation/make_torch_files_hcp.py --idx $IDX ${out_args}
